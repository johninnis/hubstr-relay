{
    "name": "innis/hubstr-relay",
    "description": "A personal Nostr relay in PHP: your public presence and private event archive in one SQLite-backed server, managed over NIP-86.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "John Innis",
            "email": "john@innis.xyz",
            "homepage": "https://www.innis.xyz/"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-ffi": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "amphp/amp": "^3.1.3",
        "amphp/byte-stream": "^2.1.3",
        "amphp/http": "^2.1.2",
        "amphp/http-server": "^3.4.8",
        "amphp/http-server-router": "^2.0",
        "amphp/http-server-static-content": "^2.1",
        "amphp/parallel": "^2.4",
        "amphp/socket": "^2.4.1",
        "amphp/sync": "^2.3.1",
        "innis/hubstr-core": "^0.2",
        "innis/nostr-core": "^0.11",
        "innis/nostr-relay": "^0.15",
        "psr/log": "^3.0.2",
        "revolt/event-loop": "^1.0.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.29",
        "innis/coding-standards": "^0.2.4",
        "league/uri": "^7.10",
        "monolog/monolog": "^3.12.1",
        "phpstan/phpstan": "~2.3.5",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpunit/phpunit": "^13.4.6",
        "rector/rector": "~2.8.4"
    },
    "autoload": {
        "psr-4": {
            "Innis\\Hubstr\\Relay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innis\\Hubstr\\Relay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "phpunit",
            "@analyse"
        ],
        "test-unit": "phpunit --testsuite=Unit",
        "test-integration": "phpunit --testsuite=Integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/tests/coverage/html --coverage-text --coverage-clover var/tests/coverage/clover.xml",
        "analyse": "phpstan analyse",
        "fix-style": "php-cs-fixer fix",
        "check-style": "php-cs-fixer fix --dry-run --diff",
        "rector": "rector process",
        "check-rector": "rector process --dry-run",
        "check-path-lengths": "check-path-lengths"
    },
    "config": {
        "sort-packages": true
    }
}
